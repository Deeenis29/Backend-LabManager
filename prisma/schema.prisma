// ==============================
// Prisma Schema - LabManager Clinic (Corregido)
// ==============================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// USUARIOS Y AUTENTICACIÓN
// ==========================================

model User {
  id                    Int        @id @default(autoincrement())
  email                 String     @unique
  passwordHash          String
  passwordSalt          String
  role                  Role
  documentType          DocumentType
  documentNumber        String
  emailVerified         Boolean    @default(false)
  emailVerifiedAt       DateTime?
  isActive              Boolean    @default(true)
  lastLoginAt           DateTime?
  loginAttempts         Int        @default(0)
  lockedUntil           DateTime?
  passwordResetToken    String?
  passwordResetExpires  DateTime?
  lastPasswordChange    DateTime?
  twoFactorEnabled      Boolean    @default(false)
  twoFactorSecret       String?

  // Relaciones
  profile               Profile?
  doctor                Doctor?
  patient               Patient?
  createdSamples        Sample[]   @relation("SampleCollectedBy")
  handledSamples        CustodyRecord[]
  inventoryMovements    InventoryMovement[]
  qualityControls       QualityControl[]
  notifications         Notification[]
  auditLogs             AuditLog[]
  settingsUpdates       SystemSetting[]
  refreshTokens         RefreshToken[]

  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  deletedAt             DateTime?  // Soft delete

  @@unique([documentType, documentNumber])
  @@index([email])
  @@index([isActive, role])
  @@index([lastLoginAt])
}

model RefreshToken {
  id           Int       @id @default(autoincrement())
  tokenHash    String    @unique
  userId       Int
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  revoked      Boolean   @default(false)
  replacedById Int? 
  replacedBy   RefreshToken? @relation("replacement", fields: [replacedById], references: [id])
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  ipAddress    String?
  userAgent    String?
  reason       String?

  // 👇 inversa correcta (plural, sin campo extra)
  replacedTokens RefreshToken[] @relation("replacement")
}


enum Role {
  ADMIN
  DOCTOR
  TECHNICIAN
  RECEPTIONIST
  PATIENT
  QUALITY_MANAGER
}

enum DocumentType {
  DNI
  CE
  PASSPORT
  RUC
  OTHER
}

// ==========================================
// PERFILES
// ==========================================

model Profile {
  id                    Int       @id @default(autoincrement())
  userId                Int       @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName             String
  lastName              String
  middleName            String?
  phone                 String?
  alternativePhone      String?
  address               String?
  city                  String?
  state                 String?
  country               String    @default("PE")
  postalCode            String?
  birthDate             DateTime?
  gender                Gender?
  bloodType             BloodType?
  avatar                String?   // URL del avatar

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?

  @@index([firstName, lastName])
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum BloodType {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
}

// ==========================================
// DOCTORES Y ESPECIALIDADES
// ==========================================

model Doctor {
  id                    Int               @id @default(autoincrement())
  userId                Int               @unique
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  licenseNumber         String            @unique
  collegeMember         String?           // Colegio médico
  specialties           DoctorSpecialty[]
  results               Result[]
  isActive              Boolean           @default(true)

  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  deletedAt             DateTime?
}

model Specialty {
  id                    Int               @id @default(autoincrement())
  name                  String            @unique
  code                  String?           @unique
  description           String?
  doctors               DoctorSpecialty[]
  isActive              Boolean           @default(true)

  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
}

model DoctorSpecialty {
  doctorId              Int
  specialtyId           Int
  doctor                Doctor            @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  specialty             Specialty         @relation(fields: [specialtyId], references: [id], onDelete: Cascade)
  certificationDate     DateTime?
  expirationDate        DateTime?

  @@id([doctorId, specialtyId])
}

// ==========================================
// PACIENTES
// ==========================================

model Patient {
  id                    Int             @id @default(autoincrement())
  userId                Int             @unique
  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  medicalRecordNumber   String?         @unique
  medicalHistory        String?
  allergies             String?
  currentMedications    String?
  emergencyContact      String?
  emergencyPhone        String?
  insuranceProvider     String?
  insuranceNumber       String?
  preferredLanguage     String?         @default("es")

  // Relaciones
  samples               Sample[]
  records               MedicalRecord[]

  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  deletedAt             DateTime?

  @@index([medicalRecordNumber])
  @@index([insuranceProvider])
}

model MedicalRecord {
  id                    Int       @id @default(autoincrement())
  patientId             Int
  patient               Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  type                  RecordType
  title                 String
  description           String
  attachmentUrl         String?
  createdById           Int?

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([patientId, type])
  @@index([createdAt])
}

enum RecordType {
  CONSULTATION
  DIAGNOSIS
  TREATMENT
  ALLERGY
  MEDICATION
  SURGERY
  VACCINATION
  OTHER
}

// ==========================================
// SITIOS DE RECOLECCIÓN
// ==========================================

model CollectionSite {
  id                    Int       @id @default(autoincrement())
  name                  String
  code                  String?   @unique
  address               String?
  phone                 String?
  isActive              Boolean   @default(true)
  samples               Sample[]

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([code])
}

// ==========================================
// ANÁLISIS Y PROTOCOLOS
// ==========================================

model Analysis {
  id                    Int                 @id @default(autoincrement())
  name                  String
  code                  String?             @unique
  description           String?
  category              AnalysisCategory?
  unitOfMeasure         String?
  methodology           String?
  turnaroundTime        Int?                // Tiempo en horas
  price                 Float?
  isActive              Boolean             @default(true)

  // Relaciones
  protocolId            Int?
  protocol              Protocol?           @relation(fields: [protocolId], references: [id])
  results               Result[]
  requires              AnalysisInventory[]
  referenceRanges       ReferenceRange[]
  qualityControls       QualityControl[]

  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  deletedAt             DateTime?

  @@index([code])
  @@index([category])
  @@index([isActive])
}

enum AnalysisCategory {
  HEMATOLOGY
  BIOCHEMISTRY
  IMMUNOLOGY
  MICROBIOLOGY
  PARASITOLOGY
  URINE_ANALYSIS
  HORMONES
  TUMOR_MARKERS
  GENETICS
  SEROLOGY
  OTHER
}

model Protocol {
  id                    Int        @id @default(autoincrement())
  name                  String
  version               String     @default("1.0")
  parameters            Json
  instructions          String?
  isActive              Boolean    @default(true)
  supersedes            Int?       // ID del protocolo anterior
  supersededBy          Int?       // ID del protocolo que lo reemplaza

  analyses              Analysis[]

  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  @@index([isActive, version])
}

model ReferenceRange {
  id                    Int       @id @default(autoincrement())
  analysisId            Int
  analysis              Analysis  @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  ageMinMonths          Int?      // Edad mínima en meses
  ageMaxMonths          Int?      // Edad máxima en meses
  gender                Gender?
  minValue              Float?
  maxValue              Float?
  textValue             String?   // Para valores no numéricos
  unit                  String?
  condition             String?   // Condiciones especiales
  description           String?
  isActive              Boolean   @default(true)

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([analysisId, gender])
  @@index([analysisId, ageMinMonths, ageMaxMonths])
}

model AnalysisInventory {
  analysisId            Int
  inventoryItemId       Int
  requiredAmount        Int
  isOptional            Boolean   @default(false)

  analysis              Analysis       @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  inventoryItem         InventoryItem  @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@id([analysisId, inventoryItemId])
}

// ==========================================
// MUESTRAS Y CADENA DE CUSTODIA
// ==========================================

model Sample {
  id                    Int                   @id @default(autoincrement())
  code                  String                @unique @default(uuid())
  barcode               String?               @unique
  patientId             Int
  patient               Patient               @relation(fields: [patientId], references: [id], onDelete: Restrict)
  collectionSiteId      Int?
  collectionSite        CollectionSite?       @relation(fields: [collectionSiteId], references: [id])
  sampleType            SampleType
  containerType         ContainerType?
  volume                Float?                // ml
  temperature           Float?                // °C
  ph                    Float?
  color                 String?
  appearance            SampleAppearance?
  priority              Priority              @default(NORMAL)
  status                SampleStatus          @default(PENDING)
  comments              String?
  specialInstructions   String?

  // Tiempos importantes
  collectedAt           DateTime              @default(now())
  collectedBy           Int?
  collectedByUser       User?                 @relation("SampleCollectedBy", fields: [collectedBy], references: [id])
  receivedAt            DateTime?
  processedAt           DateTime?
  completedAt           DateTime?
  expiresAt             DateTime?

  // Condiciones de transporte
  transportConditions   String?
  transportTemperature  Float?

  // Relaciones
  results               Result[]
  inventoryUsages       SampleInventoryUsage[]
  inventoryMovements    InventoryMovement[]
  custodyChain          CustodyRecord[]

  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  deletedAt             DateTime?

  @@index([patientId, collectedAt])
  @@index([status, createdAt])
  @@index([barcode])
  @@index([code])
  @@index([collectedAt])
}

enum SampleType {
  BLOOD_SERUM
  BLOOD_PLASMA
  BLOOD_WHOLE
  URINE_RANDOM
  URINE_24H
  URINE_FIRST_MORNING
  STOOL
  SALIVA
  CEREBROSPINAL_FLUID
  TISSUE
  SWAB
  SPUTUM
  OTHER
}

enum ContainerType {
  TUBE_RED
  TUBE_YELLOW
  TUBE_PURPLE
  TUBE_BLUE
  TUBE_GREEN
  TUBE_GRAY
  STERILE_CONTAINER
  URINE_CUP
  OTHER
}

enum SampleAppearance {
  CLEAR
  TURBID
  CLOUDY
  BLOODY
  HEMOLYZED
  LIPEMIC
  ICTERIC
}

enum SampleStatus {
  PENDING
  RECEIVED
  IN_ANALYSIS
  COMPLETED
  REJECTED
  EXPIRED
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
  STAT
}

model CustodyRecord {
  id                    Int      @id @default(autoincrement())
  sampleId              Int
  sample                Sample   @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  handledBy             Int
  user                  User     @relation(fields: [handledBy], references: [id])
  action                CustodyAction
  location              String?
  temperature           Float?
  condition             String?
  notes                 String?

  createdAt             DateTime @default(now())

  @@index([sampleId, createdAt])
}

enum CustodyAction {
  COLLECTED
  RECEIVED
  TRANSFERRED
  ANALYZED
  STORED
  DISCARDED
  REJECTED
}

// ==========================================
// RESULTADOS
// ==========================================

model Result {
  id                    Int        @id @default(autoincrement())
  sampleId              Int
  sample                Sample     @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  analysisId            Int
  analysis              Analysis   @relation(fields: [analysisId], references: [id], onDelete: Restrict)
  doctorId              Int?
  doctor                Doctor?    @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  equipmentId           Int?
  equipment             Equipment? @relation(fields: [equipmentId], references: [id])

  // Valores del resultado
  numericValue          Float?
  textValue             String?
  booleanValue          Boolean?
  valueJson             Json?      // Para resultados complejos
  unit                  String?

  // Interpretación
  isNormal              Boolean?
  isCritical            Boolean    @default(false)
  interpretation        String?
  comments              String?

  // URLs de archivos
  reportUrl             String?
  imageUrls             String[]   // Array de URLs de imágenes

  // Control de calidad
  qcPassed              Boolean    @default(false)
  qcComments            String?

  // Validación
  isValidated           Boolean    @default(false)
  validatedAt           DateTime?
  validatedBy           Int?

  // Entrega
  isDelivered           Boolean    @default(false)
  deliveredAt           DateTime?
  deliveryMethod        DeliveryMethod?

  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  deletedAt             DateTime?

  @@unique([sampleId, analysisId])
  @@index([sampleId, analysisId])
  @@index([doctorId, createdAt])
  @@index([createdAt])
  @@index([isCritical, isValidated])
}

enum DeliveryMethod {
  EMAIL
  SMS
  PORTAL
  PHYSICAL
  PHONE
}

// ==========================================
// EQUIPOS DE LABORATORIO
// ==========================================

model Equipment {
  id                    Int                @id @default(autoincrement())
  name                  String
  model                 String?
  serialNumber          String?            @unique
  manufacturer          String?
  status                EquipmentStatus    @default(ACTIVE)
  location              String?
  description           String?

  // Fechas de mantenimiento
  lastMaintenance       DateTime?
  nextMaintenance       DateTime?
  calibrationDue        DateTime?
  warrantyExpires       DateTime?

  // Configuración
  parameters            Json?
  isActive              Boolean            @default(true)

  // Relaciones
  results               Result[]
  maintenanceRecords    MaintenanceRecord[]

  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  deletedAt             DateTime?

  @@index([status, isActive])
  @@index([nextMaintenance])
}

enum EquipmentStatus {
  ACTIVE
  MAINTENANCE
  CALIBRATION
  OUT_OF_ORDER
  RETIRED
}

model MaintenanceRecord {
  id                    Int       @id @default(autoincrement())
  equipmentId           Int
  equipment             Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  type                  MaintenanceType
  title                 String
  description           String
  performedBy           String
  cost                  Float?
  partsReplaced         String?
  nextMaintenanceDate   DateTime?

  createdAt             DateTime  @default(now())

  @@index([equipmentId, type])
  @@index([createdAt])
}

enum MaintenanceType {
  PREVENTIVE
  CORRECTIVE
  CALIBRATION
  VALIDATION
  CLEANING
  UPGRADE
}

// ==========================================
// CONTROL DE CALIDAD
// ==========================================

model QualityControl {
  id                    Int      @id @default(autoincrement())
  analysisId            Int
  analysis              Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  lotNumber             String
  level                 QCLevel
  expectedValue         Float?
  acceptableRange       Float?
  unit                  String?
  result                Float?
  status                QCStatus @default(PENDING)
  deviation             Float?
  comments              String?

  testedBy              Int?
  testedByUser          User?    @relation(fields: [testedBy], references: [id])
  testedAt              DateTime?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([analysisId, testedAt])
  @@index([status, testedAt])
}

enum QCLevel {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum QCStatus {
  PENDING
  PASSED
  FAILED
  REVIEW_REQUIRED
  REPEATED
}

// ==========================================
// INVENTARIO
// ==========================================

model InventoryItem {
  id                    Int                  @id @default(autoincrement())
  name                  String
  code                  String?              @unique
  type                  InventoryType
  category              String?
  brand                 String?
  supplier              String?
  supplierCode          String?

  // Cantidades
  quantity              Int                  @default(0)
  minStock              Int                  @default(0)
  maxStock              Int?
  unit                  String               @default("unit")

  // Fechas importantes
  expiration            DateTime?
  manufacturedDate      DateTime?

  // Costos
  unitCost              Float?
  totalCost             Float?

  // Almacenamiento
  location              String?
  storageConditions     String?

  // Estado
  isActive              Boolean              @default(true)
  isConsumable          Boolean              @default(true)

  // Relaciones
  usages                SampleInventoryUsage[]
  movements             InventoryMovement[]
  analysisRequirements  AnalysisInventory[]

  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  deletedAt             DateTime?

  @@index([type, isActive])
  @@index([expiration])
  @@index([quantity])
  @@index([code])
}

enum InventoryType {
  REAGENT
  CONSUMABLE
  EQUIPMENT
  QUALITY_CONTROL
  CALIBRATOR
  CLEANING_SUPPLY
  OFFICE_SUPPLY
}

model SampleInventoryUsage {
  id                    Int           @id @default(autoincrement())
  sampleId              Int
  inventoryItemId       Int
  quantityUsed          Int
  unitCost              Float?
  notes                 String?

  sample                Sample        @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  inventoryItem         InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  createdAt             DateTime      @default(now())

  @@index([sampleId])
  @@index([inventoryItemId])
  @@unique([sampleId, inventoryItemId])
}

model InventoryMovement {
  id                    Int           @id @default(autoincrement())
  inventoryItemId       Int
  type                  MovementType
  quantity              Int
  unitCost              Float?
  totalCost             Float?
  reason                String?
  reference             String?       // Número de factura, orden, etc.

  // Usuario que realizó el movimiento
  createdById           Int?
  createdBy             User?         @relation(fields: [createdById], references: [id])

  // Si está relacionado con una muestra
  sampleId              Int?
  sample                Sample?       @relation(fields: [sampleId], references: [id])

  inventoryItem         InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  createdAt             DateTime      @default(now())

  @@index([inventoryItemId, type])
  @@index([createdAt])
  @@index([type, createdAt])
}

enum MovementType {
  ENTRY
  EXIT
  ADJUSTMENT
  TRANSFER
  EXPIRED
  DAMAGED
}

// ==========================================
// NOTIFICACIONES Y ALERTAS
// ==========================================

model Notification {
  id                    Int              @id @default(autoincrement())
  userId                Int
  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type                  NotificationType
  title                 String
  message               String
  isRead                Boolean          @default(false)
  priority              Priority         @default(NORMAL)

  // Referencia al objeto relacionado
  relatedId             Int?
  relatedType           String?          // SAMPLE, RESULT, INVENTORY, EQUIPMENT

  // URLs de acción
  actionUrl             String?

  // Configuración de entrega
  sentByEmail           Boolean          @default(false)
  sentBySms             Boolean          @default(false)
  emailSentAt           DateTime?
  smsSentAt             DateTime?

  expiresAt             DateTime?
  createdAt             DateTime         @default(now())
  readAt                DateTime?

  @@index([userId, isRead])
  @@index([createdAt])
  @@index([type, priority])
}

enum NotificationType {
  RESULT_READY
  CRITICAL_VALUE
  SAMPLE_RECEIVED
  SAMPLE_EXPIRED
  INVENTORY_LOW
  INVENTORY_EXPIRED
  EQUIPMENT_MAINTENANCE
  QC_FAILED
  SYSTEM_ALERT
  APPOINTMENT_REMINDER
  PAYMENT_DUE
}

// ==========================================
// CONFIGURACIÓN DEL SISTEMA
// ==========================================

model SystemSetting {
  id                    Int      @id @default(autoincrement())
  key                   String   @unique
  value                 String
  dataType              SettingDataType @default(STRING)
  category              String?
  description           String?
  isEditable            Boolean  @default(true)
  isPublic              Boolean  @default(false) // Si puede ser accedido sin autenticación

  updatedBy             Int?
  updatedByUser         User?    @relation(fields: [updatedBy], references: [id])

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([category])
}

enum SettingDataType {
  STRING
  NUMBER
  BOOLEAN
  JSON
  DATE
  EMAIL
  URL
}

// ==========================================
// AUDITORÍA Y TRAZABILIDAD
// ==========================================

model AuditLog {
  id                    Int      @id @default(autoincrement())
  userId                Int?
  user                  User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action                AuditAction
  tableName             String
  recordId              Int?
  oldValues             Json?
  newValues             Json?

  // Información de la sesión
  ipAddress             String?
  userAgent             String?
  sessionId             String?

  // Información adicional
  description           String?
  severity              LogSeverity @default(INFO)

  createdAt             DateTime @default(now())

  @@index([tableName, recordId])
  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
}

enum AuditAction {
  CREATE
  READ
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  LOGIN_FAILED
  PASSWORD_RESET
  EXPORT_DATA
  PRINT_REPORT
  ACCESS_DENIED
  SYSTEM_ERROR
}

enum LogSeverity {
  DEBUG
  INFO
  WARNING
  ERROR
  CRITICAL
}

// ==========================================
// REPORTES Y DASHBOARDS
// ==========================================

model Report {
  id                    Int          @id @default(autoincrement())
  name                  String
  type                  ReportType
  description           String?
  query                 String?      // SQL query o configuración
  parameters            Json?        // Parámetros del reporte
  isPublic              Boolean      @default(false)
  isActive              Boolean      @default(true)

  // Programación automática
  isScheduled           Boolean      @default(false)
  scheduleExpression    String?      // Cron expression
  lastRun               DateTime?
  nextRun               DateTime?

  createdBy             Int?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@index([type, isActive])
}

enum ReportType {
  DAILY_SUMMARY
  MONTHLY_SUMMARY
  PATIENT_RESULTS
  QC_REPORT
  INVENTORY_STATUS
  EQUIPMENT_STATUS
  FINANCIAL_SUMMARY
  CUSTOM
}
